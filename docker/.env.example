# Copie para docker/.env e ajuste. Lido automaticamente pelo docker compose.

# Porta HTTPS em produção (https://localhost:NGINX_HTTPS_PORT)
NGINX_HTTPS_PORT=443

# Porta HTTPS em desenvolvimento (make dev)
NGINX_DEV_HTTPS_PORT=8443

# Só têm efeito se descomentadas no docker-compose.yml (environment:)
RETENTION_DAYS=3
MAX_FILE_SIZE_BYTES=1073741824
CHUNK_SIZE_BYTES=52428800
CLEANUP_INTERVAL_MINUTES=60
